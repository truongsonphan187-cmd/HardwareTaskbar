# ====================================================================
# Git Ignore for HardwareTaskbar (CMake / C++ / Visual Studio / MSVC)
# ====================================================================

# Build & Output directories
build/
bin/
out/
dist/
x64/
x86/
ARM64/
Debug/
Release/
RelWithDebInfo/
MinSizeRel/

# CMake artifacts & caches
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Testing/
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
CMakeUserPresets.json

# Visual Studio / MSVC compilation outputs
*.obj
*.o
*.lib
*.a
*.exp
*.dll
*.exe
*.pdb
*.ilk
*.idb
*.res
*.pch
*.ipch

# Visual Studio user-specific & project files
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.vcxproj.user

# Visual Studio build logs & tracking
*.tlog
*.recipe
*.lastbuildstate
*.log

# IDE & Editor configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.fleet/
.vimspector.json

# Windows OS system files
[Dd]esktop.ini
Thumbs.db
$RECYCLE.BIN/
*.lnk

# Crash dumps & profiling
*.dmp
*.dump
*.coverage
*.coveragexml

# Temporary, scratch & package cache
scratch/
tmp/
temp/
*.tmp
*.bak
*.swp
*~

# Tools & External portable binaries (LibreHardwareMonitor, HWiNFO, etc.)
tools/
packages/
